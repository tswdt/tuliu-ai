# Supabase 配置
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 数据库 URL (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# AI API 配置
DOUBAO_API_KEY=your-doubao-api-key
FLUX_API_KEY=your-flux-api-key
TONGYI_API_KEY=your-tongyi-api-key

# API易配置
APIYI_API_URL=https://api.apiyi.com/v1/images/generations
APIYI_API_KEY=your-apiyi-api-key
APIYI_MODEL=nano-banana-2
APIYI_LLM_URL=https://api.apiyi.com/v1/chat/completions
APIYI_LLM_MODEL=gpt-4o-mini

# 支付配置
WECHAT_PAY_MCHID=your-wechat-mchid
WECHAT_PAY_API_KEY=your-wechat-api-key
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# 站点配置
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# 免费额度配置
FREE_GENERATIONS=10

# Redis 配置
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
