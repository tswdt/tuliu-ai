// Prisma schema for user authentication, credits, and subscriptions

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  credits    Int     @default(0)
  subscriptions Subscription[]
}

model Subscription {
  id                Int     @id @default(autoincrement())
  userId            Int
  plan              String
  status            String
  startDate         DateTime
  endDate           DateTime

  user              User    @relation(fields: [userId], references: [id])
}
