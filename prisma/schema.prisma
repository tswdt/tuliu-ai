generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  role          String   @default("INDIVIDUAL")
  credits       Int      @default(10)
  totalGenerations Int   @default(0)
  wechatOpenId  String?  @unique
  wechatUnionId String?
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  onboardingCompleted Boolean @default(false)
  stripeCustomerId String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  generations   Generation[]
  orders        Order[]
  subscriptions Subscription[]
  apiKeys       ApiKey[]
  quota         Quota?
  activeGeneration ActiveGeneration?
  mediaFolders  MediaFolder[]
  mediaItems    MediaItem[]
  projects      Project[]
  creditLogs    CreditLog[]
  passwordResets PasswordReset[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([wechatOpenId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  credits     Int
  role        String
  type        String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  features    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  subscriptions Subscription[]

  @@index([isActive])
  @@index([role])
}

model Order {
  id            String    @id @default(cuid())
  userId        String
  planId        String?
  amount        Float
  status        String    @default("PENDING")
  paymentMethod String?
  transactionId String?   @unique
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan?     @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String
  planId      String
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("active")
  autoRenew   Boolean   @default(true)
  stripeSubscriptionId String? @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan      @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  keyHash   String    @unique
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

model Project {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String?
  status          String   @default("draft")
  platform        String   @default("TAOBAO")
  category        String?
  style           String?
  productData     String   @default("{}")
  recognitionData String   @default("{}")
  layoutData      String   @default("{}")
  copyData        String   @default("{}")
  sourceProjectId String?
  isTemplate      Boolean  @default(false)
  thumbnailUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks           Task[]
  projectImages   ProjectImage[]
  exports         Export[]

  @@index([userId])
  @@index([status])
  @@index([platform])
  @@index([createdAt])
  @@index([isTemplate])
}

model ProjectImage {
  id          String   @id @default(cuid())
  projectId   String
  imageUrl    String
  imageType   String
  label       String?
  sortOrder   Int      @default(0)
  prompt      String?
  size        String?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([imageType])
}

model Task {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  type          String
  status        String    @default("pending")
  progress      Int       @default(0)
  stage         String?
  message       String?
  payload       String    @default("{}")
  result        String    @default("{}")
  error         String?
  retryCount    Int       @default(0)
  maxRetries    Int       @default(3)
  creditCost    Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model CreditLog {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  balance     Int
  type        String
  description String?
  taskId      String?
  projectId   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Generation {
  id                String    @id @default(cuid())
  userId            String
  status            String    @default("QUEUED")
  workflowStage     String?   @default("PREPROCESSING")
  platform          String    @default("CUSTOM")
  category          String?
  style             String?
  resolution        String?   @default("FOUR_K")
  productName       String?
  sellingPoints     String
  prompt            String?
  originalImageUrl  String?
  whiteBgImageUrl   String?
  resultUrls        String
  copyContent       String
  copyText          String?
  mainImageUrl      String?
  sceneImageUrls    String
  detailImageUrls   String
  sellingPointImageUrls String
  detailPageUrl     String?
  progress          Int       @default(0)
  creditUsed        Int       @default(1)
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItems        MediaItem[]

  @@index([userId])
  @@index([status])
  @@index([platform])
  @@index([createdAt])
}

model ActiveGeneration {
  id            String   @id @default(cuid())
  userId        String   @unique
  generationId  String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Quota {
  id        String   @id @default(cuid())
  userId    String   @unique
  total     Int      @default(0)
  used      Int      @default(0)
  remaining Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MediaFolder {
  id        String        @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderHierarchy")
  items     MediaItem[]

  @@index([userId])
  @@index([parentId])
}

model MediaItem {
  id           String       @id @default(cuid())
  userId       String
  folderId     String?
  name         String
  url          String
  type         String
  imageType    String?
  source       String       @default("upload")
  tags         String       @default("[]")
  size         Int?
  width        Int?
  height       Int?
  generationId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       MediaFolder? @relation(fields: [folderId], references: [id])
  generation   Generation?  @relation(fields: [generationId], references: [id])

  @@index([userId])
  @@index([folderId])
  @@index([generationId])
  @@index([imageType])
  @@index([source])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  platform    String
  category    String?
  style       String?
  type        String   @default("detail_page")
  thumbnailUrl String?
  layoutData  String   @default("{}")
  copyData    String   @default("{}")
  promptData  String   @default("{}")
  isPublic    Boolean  @default(true)
  isPremium   Boolean  @default(false)
  useCount    Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([platform])
  @@index([category])
  @@index([style])
  @@index([isPublic])
  @@index([type])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  name        String
  platform    String
  category    String?
  imageType   String
  style       String?
  promptText  String
  negativePrompt String?
  variables   String   @default("[]")
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([platform])
  @@index([category])
  @@index([imageType])
  @@index([isActive])
  @@index([version])
}

model ComplianceRule {
  id          String   @id @default(cuid())
  category    String
  ruleType    String
  description String
  keywords    String   @default("[]")
  action      String   @default("warn")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([ruleType])
  @@index([isActive])
}

model Export {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  format      String
  status      String   @default("pending")
  fileUrl     String?
  fileSize    Int?
  width       Int?
  height      Int?
  creditCost  Int      @default(0)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
